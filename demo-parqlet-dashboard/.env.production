# ─── Demo site configuration ────────────────────────────────────────────────
#
# COMMITTED ON PURPOSE (see .gitignore). NEXT_PUBLIC_* values are inlined at
# BUILD time, so this file is what guarantees the deployed demo runs on mock
# data. Leaving it to the Vercel dashboard would mean one missing variable
# turns the demo into a live client pointed at a backend that will reject it,
# and the failure would look like an outage rather than a misconfiguration.
#
# There are no secrets here, and there must never be: everything this app
# needs in demo mode is served from app/lib/mock-data.

# Every /api/* route reads from app/lib/mock-data instead of proxying.
NEXT_PUBLIC_MOCK_ENABLED=true

# The app calls its own origin for /api/*. Empty means "same origin", which
# is what Vercel serves, so this works on any preview URL as well as on
# demo.parqlet.com without being rebuilt per domain.
NEXT_PUBLIC_API_URL=

# Stripe is never contacted in mock mode; the subscription screens read their
# figures from mock JSON. This is a well-known Stripe TEST publishable key,
# present only so any component that constructs a Stripe object at import
# time does not throw during the build.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_TYooMQauvdEDq54NiTphI7jx

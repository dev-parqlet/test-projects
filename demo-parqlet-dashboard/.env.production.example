# Production environment — VM deployment credentials
# Copy this file to .env.production and fill in real values.
# .env.production is gitignored — NEVER commit real credentials.
#
# For CI/CD: values are embedded into the deploy script via heredoc.
# Only VM_HOST, VM_USER, VM_SSH_PORT, VM_SSH_KEY go to GitHub Actions secrets.
#
# Staging ("dev") environment uses the same key slots with STAGING_ prefixes
# in GitHub Actions (STAGING_VM_HOST, STAGING_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY,
# etc.). The staging deploy workflow picks the matching STAGING_* secret at
# run time. See .github/workflows/deploy.yml for the full mapping.

# ── VM Infrastructure ────────────────────────────────────────────────────────
VM_HOST=your.vm.ip.address           # e.g. 34.24.156.2
VM_USER=root
VM_SSH_PORT=22
VM_SSH_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... you@your-machine

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.parqlet.com
NODE_ENV=production
PORT=8080

# Stripe Elements — publishable key for client-side Elements flows.
# Required for /api/stripe/subscribe, card-update SetupIntent, and the
# Stripe Elements onboarding wizard step 4. NEVER place a secret key
# (sk_*) here — only publishable (pk_*) keys are safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ─── Staging ("dev") variant notes ───────────────────────────────────────────
# The staging environment runs at https://dev.parqlet.com with the backend
# proxied through https://api.dev.parqlet.com. Same code, different values
# for the build-arg inlined into the client bundle (NEXT_PUBLIC_*) and the
# server-side runtime env (BACKEND_API_URL):
#   NEXT_PUBLIC_API_URL                → https://dev.parqlet.com
#   BACKEND_API_URL                    → https://api.dev.parqlet.com
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY → pk_test_…   (Stripe test mode)
#
# NEXT_PUBLIC_* values are baked into the client bundle at build time and so
# MUST be passed as Docker build args. The deploy workflow handles this
# automatically by reading STAGING_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY from
# the staging GitHub Environment. See .github/workflows/deploy.yml.
